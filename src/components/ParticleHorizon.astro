---
// Decorative particle horizon for the home hero. The renderer is deliberately
// tiny (Canvas 2D, no dependencies) and only runs on the dark theme.
---
<div class="gm-particle-world" data-particle-world aria-hidden="true">
  <canvas
    class="gm-particle-canvas gm-particle-canvas--static"
    data-particle-static
  ></canvas>
  <canvas
    class="gm-particle-canvas gm-particle-canvas--dynamic"
    data-particle-canvas
  ></canvas>
  <span class="gm-particle-scrim"></span>
  <span class="gm-particle-grain"></span>
</div>

<script>
  import '../scripts/particle-horizon';
</script>
