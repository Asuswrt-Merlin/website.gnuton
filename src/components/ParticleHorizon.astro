---
// Decorative particle globe used as the site-wide ambient background. The
// renderer is a tiny Canvas 2D scene (no dependencies) with a light and a dark
// palette; scroll progress is applied by Motion.astro.
interface Props {
  /** Interior pages use a quieter version of the globe. */
  ambient?: boolean;
}

const { ambient = false } = Astro.props;
---
<div
  class:list={['gm-particle-world', { 'gm-particle-world--ambient': ambient }]}
  data-particle-world
  data-particle-ambient={ambient ? 'true' : undefined}
  aria-hidden="true"
>
  <canvas
    class="gm-particle-canvas gm-particle-canvas--static"
    data-particle-static
  ></canvas>
  <canvas
    class="gm-particle-canvas gm-particle-canvas--dynamic"
    data-particle-canvas
  ></canvas>
  <span class="gm-particle-grain"></span>
</div>

<script>
  import '../scripts/particle-horizon';
</script>
