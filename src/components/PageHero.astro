---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
  /** Use the full-height particle-horizon layout. Pair with the background slot. */
  world?: boolean;
}

const { eyebrow, title, subtitle, compact = false, world = false } = Astro.props;
const hasBackground = Astro.slots.has('background');
const isWorld = world && hasBackground;
---

<section class:list={['hero', 'gm-hero', { 'is-medium': !compact, 'gm-hero--world': isWorld }]}>
  {hasBackground && <slot name="background" />}
  <div class:list={['hero-body', { 'gm-hero-body': isWorld }]}>
    <div class="container">
      <div class:list={['columns is-vcentered', { 'is-centered': compact }]}>
        <div class:list={['column', compact ? 'is-two-thirds has-text-centered' : 'is-three-fifths']}>
          {eyebrow && <p class="gm-eyebrow mb-3">{eyebrow}</p>}
          <h1 class:list={['gm-display', 'mb-4']}>{title}</h1>
          {subtitle && (
            <p class:list={['subtitle is-5', { 'mx-auto': compact }]}>{subtitle}</p>
          )}
          {Astro.slots.has('default') && (
            <div class:list={['gm-hero-lead', { 'mx-auto': compact }]}>
              <slot />
            </div>
          )}
        </div>
        {
          !compact && (
            <div class="column is-two-fifths">
              <slot name="aside" />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
