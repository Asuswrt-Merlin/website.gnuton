---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
}

const { eyebrow, title, subtitle, compact = false } = Astro.props;
---

<section class:list={['hero', 'gm-hero', { 'is-medium': !compact }]}>
  <div class="hero-body">
    <div class="container">
      <div class:list={['columns is-vcentered', { 'is-centered': compact }]}>
        <div class:list={['column', compact ? 'is-two-thirds has-text-centered' : 'is-three-fifths']}>
          {eyebrow && <p class="gm-eyebrow mb-3" data-hero-reveal style="--gm-hero-delay: 40ms">{eyebrow}</p>}
          <h1 class:list={['gm-display', 'mb-4']} data-hero-reveal style="--gm-hero-delay: 120ms">{title}</h1>
          {subtitle && (
            <p
              class:list={['subtitle is-5', { 'mx-auto': compact }]}
              data-hero-reveal
              style="--gm-hero-delay: 200ms"
            >
              {subtitle}
            </p>
          )}
          {Astro.slots.has('default') && (
            <div
              class:list={['gm-hero-lead', { 'mx-auto': compact }]}
              data-hero-reveal
              style="--gm-hero-delay: 280ms"
            >
              <slot />
            </div>
          )}
        </div>
        {
          !compact && (
            <div class="column is-two-fifths" data-hero-reveal="media" style="--gm-hero-delay: 220ms">
              <slot name="aside" />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>