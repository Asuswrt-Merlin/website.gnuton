---
import { firmwareForRouter } from '../data/firmware';
import type { RouterModel } from '../data/routers';
import { branchById } from '../data/routers';
import { withBase } from '../utils/url';

interface Props {
  router: RouterModel;
}

const { router } = Astro.props;
const branch = branchById(router.branch);
const firmware = firmwareForRouter(router);
const searchText = [
  router.name,
  ...(router.aliases ?? []),
  router.note ?? '',
  branch.name,
  ...(firmware ? [firmware.release.tag, firmware.release.prerelease ? 'beta' : 'stable'] : []),
].join(' ');
---

<article class="card gm-card gm-router-card" data-router-card data-search={searchText}>
  <div class="gm-router-media">
    <span class="gm-chip">{branch.name}</span>
    {router.badge && <span class="gm-badge">{router.badge}</span>}
    <img
      src={withBase(`/images/routers/${router.image}`)}
      alt={`ASUS ${router.name} router`}
      width="320"
      height="260"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="card-content gm-card-content">
    <h3 class="title is-5 mb-2">{router.name}</h3>
    {
      router.aliases && router.aliases.length > 0 && (
        <p class="gm-router-alias">Also sold as {router.aliases.join(', ')}</p>
      )
    }
    {router.note && <p class="gm-router-note">{router.note}</p>}
    {
      firmware ? (
        <p class="gm-router-version">
          <span
            class:list={[
              'gm-router-version-label',
              { 'gm-router-version-label--pre': firmware.release.prerelease },
            ]}
          >
            {firmware.release.prerelease ? 'Beta' : 'Stable'}
          </span>
          <strong>{firmware.release.tag}</strong>
        </p>
      ) : (
        <p class="gm-router-version gm-router-version--missing">No published image found</p>
      )
    }
    <div class="gm-router-links">
      {
        firmware ? (
          <a
            class="gm-router-download"
            href={firmware.asset.url}
            data-firmware-download={router.id}
            target="_blank"
            rel="noopener"
            aria-label={`Download firmware for ${router.name}`}
          >
            Download
          </a>
        ) : (
          <a href={branch.stableUrl} target="_blank" rel="noopener">
            Downloads
          </a>
        )
      }
      <a
        href={router.asusUrl}
        target="_blank"
        rel="noopener"
        aria-label={`ASUS ${router.name} specifications`}
      >
        ASUS specs <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>
