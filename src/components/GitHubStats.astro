---
import { githubStats } from '../data/stats';
import { compactNumber, formatNumber } from '../utils/format';

const tiles = [
  { value: githubStats.releaseDownloads, label: 'Release downloads' },
  { value: githubStats.stars, label: 'GitHub stars' },
  { value: githubStats.forks, label: 'Forks' },
  { value: githubStats.releases, label: 'Releases' },
];

const firstRelease = githubStats.firstRelease ? new Date(githubStats.firstRelease) : null;
const firstReleaseLabel =
  firstRelease && !Number.isNaN(firstRelease.valueOf())
    ? new Intl.DateTimeFormat('en', {
        dateStyle: 'long',
        timeZone: 'UTC',
      }).format(firstRelease)
    : null;
---

<section class="section gm-section" aria-labelledby="github-stats-title">
  <div class="container">
    <div class="gm-section-head" data-reveal="fade">
      <p class="gm-eyebrow mb-2">On GitHub</p>
      <h2 class="title is-2" id="github-stats-title">Built in public, downloaded by the community</h2>
      <p class="subtitle is-6">
        Every firmware image ships through GitHub Releases, alongside its checksums and build
        logs. The source and issue tracker stay public.
      </p>
    </div>

    <div class="gm-stats">
      {
        tiles.map((tile, index) => (
          <div data-reveal="scale" style={`--gm-reveal-delay: ${index * 80}ms`}>
            <span
              class="gm-stat-number"
              title={formatNumber(tile.value)}
              data-counter
              data-counter-final={compactNumber(tile.value)}
            >
              {compactNumber(tile.value)}
            </span>
            <span class="gm-stat-label">{tile.label}</span>
          </div>
        ))
      }
    </div>

    {
      firstRelease && firstReleaseLabel && (
        <p class="gm-stat-reference" data-reveal="fade">
          First release: <time datetime={firstRelease.toISOString()}>{firstReleaseLabel}</time>
        </p>
      )
    }
  </div>
</section>