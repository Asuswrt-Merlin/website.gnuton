---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { formatDate } from '../../utils/date';
import { readingTime } from '../../utils/reading-time';

interface Props {
  post: CollectionEntry<'guides'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('guides');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = new URL(Astro.url.pathname, Astro.site);
const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  url: canonical,
  author: { '@type': 'Organization', name: site.name, url: site.repo },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  schema={postSchema}
>
  <section class="section gm-section">
    <div class="container">
      <article class="gm-prose">
        <p class="gm-guide-meta mb-3">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {' · '}
          {readingTime(post.body ?? '')}
        </p>

        <h1 class="title is-1 mb-5">{post.data.title}</h1>

        <div class="mb-6">
          {post.data.tags.map((tag) => <span class="gm-tag">#{tag}</span>)}
        </div>

        <Content />
      </article>

      <div class="gm-notice mt-6">
        <strong>Firmware changes carry risk.</strong> Follow the release notes for your exact
        model and keep a recovery path available. The project cannot guarantee every flash
        succeeds.
      </div>

      <p class="mt-6">
        <a href="../../guides/">← Back to all guides</a>
      </p>
    </div>
  </section>
</BaseLayout>
